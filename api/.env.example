# Gnani speech (Prisma + Timbre). Key from https://app.gnani.ai/voice
GNANI_API_KEY=
# mock = free beep and canned transcript. gnani = real calls, spends credits.
SPEECH_MODE=mock

# Gemini runs the agent. Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Leave unset locally to use a SQLite file. Set to the Neon URL when deployed.
# DATABASE_URL=

# Set both when deployed.
# SESSION_SECRET=
# CRON_SECRET=
